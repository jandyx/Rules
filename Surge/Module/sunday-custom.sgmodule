#!name=sunday-custom
#!desc=Shared Sunday company rules, independent of subscription updates.
#!system=mac

[Rule]
# NTP: airport nodes drop UDP 123, so time sync must bypass proxies.
DEST-PORT,123,DIRECT
# codesign timestamps: a dropped proxy node fails signing ("timestamp service is not available").
DOMAIN,timestamp.apple.com,DIRECT
DOMAIN,files.sundayonline.top,DIRECT
DOMAIN-SUFFIX,xclient.info,DIRECT,extended-matching
